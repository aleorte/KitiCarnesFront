# Desarrollo local (Vite proxy hacia la API Nest)
VITE_API_URL=/api/v1

# Opcional: si la API local no está en 3000
# VITE_DEV_API_PROXY=http://127.0.0.1:3000

# Producción / Preview en Vercel: URL absoluta de la API (sin barra final)
# VITE_API_URL=https://<api-prod>.vercel.app/api/v1
# Si la API también usa el dominio: https://api.rindemascarnes.com/api/v1
